# --- Auth (streamlit-authenticator) ---
ADMIN_USERNAME=admin
# bcrypt hash of your password. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOURPASS', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Secret used to sign the auth cookie — set to a long random string.
COOKIE_KEY=change_me_to_a_long_random_string

# --- Tools ---
TAVILY_API_KEY=

# --- vLLM (OpenAI-compatible; serves openai/gpt-oss-20b) ---
# Local run:  http://localhost:8000/v1
# In container, start_container.sh maps host.docker.internal -> host-gateway:
VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY        # vLLM ignores it; the protocol needs a non-empty token

# --- Models (optional overrides) ---
# gpt-oss is one model, so the reasoning/fast/lead roles all default to it:
# AGENT_REASONING_MODEL=openai/gpt-oss-20b
# AGENT_FAST_MODEL=openai/gpt-oss-20b
# AGENT_LEAD_MODEL=openai/gpt-oss-20b
# REQUEST_TIMEOUT_S=900
# AGENT_LOG_LEVEL=INFO
